---
import resume from '../data/resume.json';
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

const { aiStack } = resume;

/** Recent writing, newest first, excluding drafts. */
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<div class="panel">
  <div class="intro">
    <p class="eyebrow">{aiStack.eyebrow}</p>
    <h3 class="heading">{aiStack.heading}</h3>
    <p class="lede">{aiStack.description}</p>

    {
      aiStack.links?.length > 0 && (
        <p class="ctas">
          {aiStack.links.map((link) => (
            <a
              class="btn btn-primary"
              href={link.href}
              rel="noopener"
              target="_blank"
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </p>
      )
    }
  </div>

  <ul class="pillars">
    {
      aiStack.pillars?.map((p) => (
        <li>
          <h4>{p.title}</h4>
          <p class="muted">{p.description}</p>
        </li>
      ))
    }
  </ul>
</div>

{
  posts.length > 0 && (
    <div class="feed">
      <p class="eyebrow feed-label">Notes from the build</p>
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <PostCard post={post} compact />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-l);
    padding: var(--space-m);
    background: var(--paper-raised);
    border: var(--border) var(--line);
    border-radius: var(--radius);
  }

  .heading {
    font-size: var(--step-2);
    margin-block: var(--space-3xs) var(--space-2xs);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }

  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .pillars li {
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--accent);
  }

  .pillars h4 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-block-end: 0.15rem;
  }

  .pillars p {
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .feed {
    margin-block-start: var(--space-l);
  }

  .feed-label {
    margin-block-end: var(--space-s);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .posts > li + li {
    border-top: var(--border) var(--line);
  }

  @media (max-width: 48rem) {
    .panel {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
