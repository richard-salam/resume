---
import resume from '../data/resume.json';

const studies = resume.caseStudies;
---

<ul class="grid">
  {
    studies.map((study) => {
      const Wrapper = study.href ? 'a' : 'div';
      return (
        <li>
          <Wrapper
            class="card"
            {...(study.href
              ? { href: study.href, rel: 'noopener', target: '_blank' }
              : {})}
          >
            <h3>{study.title}</h3>

            <dl>
              <div>
                <dt>Problem</dt>
                <dd>{study.problem}</dd>
              </div>
              <div>
                <dt>My role</dt>
                <dd>{study.role}</dd>
              </div>
              <div>
                <dt>Approach</dt>
                <dd>{study.approach}</dd>
              </div>
              <div>
                <dt>Result</dt>
                <dd class="result">{study.result}</dd>
              </div>
            </dl>

            {study.tags?.length > 0 && (
              <ul class="tag-row">
                {study.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
          </Wrapper>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-m);
    border: var(--border) var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), background var(--transition);
  }

  a.card:hover {
    border-color: var(--accent);
    background: var(--paper-raised);
    color: inherit;
  }

  h3 {
    font-size: var(--step-1);
  }

  a.card h3 {
    color: var(--accent-ink);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.55;
  }

  dl > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-2xs);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-block-start: 0.2em;
  }

  dd {
    margin: 0;
    color: var(--ink-muted);
  }

  .result {
    color: var(--ink);
  }

  .tag-row {
    margin-block-start: auto;
  }
</style>
