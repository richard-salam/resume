---
import resume from '../data/resume.json';
import { formatRange, duration } from '../lib/format';

const roles = resume.experience;
---

<ol class="timeline">
  {
    roles.map((role) => {
      const span = duration(role.start, role.end);
      return (
        <li class="role">
          <div class="meta">
            <h3>{role.title}</h3>
            <p class="org">
              {role.company}
              {role.location && <span class="sep">·</span>}
              {role.location}
            </p>
            <p class="dates">
              <time>{formatRange(role.start, role.end)}</time>
              {span && <span class="span">{span}</span>}
            </p>
          </div>

          <div class="body">
            {role.summary && <p class="summary">{role.summary}</p>}
            <ul class="highlights">
              {role.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            {role.stack?.length > 0 && (
              <ul class="tag-row stack">
                {role.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .role {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) 1fr;
    gap: var(--space-m) var(--space-l);
    padding-block: var(--space-m);
    border-top: var(--border) var(--line);
  }

  .role:first-child {
    border-top: 0;
    padding-block-start: 0;
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .org {
    color: var(--ink);
    font-size: var(--step-0);
    margin-block-start: 0.1rem;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .span::before {
    content: '·';
    margin-inline-end: var(--space-2xs);
  }

  .sep {
    color: var(--ink-faint);
    margin-inline: 0.35rem;
  }

  .summary {
    color: var(--ink-muted);
    margin-block-end: var(--space-2xs);
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-end: var(--space-s);
  }

  .highlights li {
    position: relative;
    padding-inline-start: var(--space-s);
  }

  .highlights li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7em;
    width: 5px;
    height: 1px;
    background: var(--line-strong);
  }

  .stack {
    font-size: 0.72rem;
  }

  @media (max-width: 48rem) {
    .role {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
