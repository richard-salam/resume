---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { withBase } from '../lib/paths';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Trims padding and hides the excerpt — used inside the AI stack feed. */
  compact?: boolean;
  featured?: boolean;
}

const { post, compact = false, featured = false } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const href = withBase(`/writing/${post.id}/`);
---

<article class:list={['card', { compact, featured }]}>
  <div class="meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {featured && <span class="badge">Featured</span>}
  </div>

  <h3>
    <a href={href}>{title}</a>
  </h3>

  {!compact && <p class="desc muted">{description}</p>}

  {
    tags.length > 0 && (
      <ul class="tag-row">
        {tags.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--ink-faint);
  }

  .badge {
    padding: 0 0.4rem;
    border-radius: 100px;
    background: var(--accent-wash);
    color: var(--accent-ink);
  }

  h3 {
    font-size: var(--step-1);
  }

  .featured h3 {
    font-size: var(--step-2);
  }

  h3 a {
    text-decoration: none;
    color: var(--ink);
  }

  h3 a:hover {
    color: var(--accent-ink);
  }

  .desc {
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 54ch;
  }

  .tag-row {
    margin-block-start: var(--space-3xs);
  }

  .compact h3 {
    font-size: var(--step-0);
  }

  .compact .tag-row {
    display: none;
  }
</style>
