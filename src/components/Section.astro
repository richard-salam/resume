---
import { withBase } from '../lib/paths';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  /** Right-aligned link rendered next to the heading, e.g. "View all →" */
  action?: { label: string; href: string };
}

const { id, title, eyebrow, action } = Astro.props;
---

<section id={id} class="section">
  <div class="wrap">
    <div class="head">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{title}</h2>
      </div>
      {
        action && (
          <a class="action no-print" href={withBase(action.href)}>
            {action.label} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-xl);
    border-top: var(--border) var(--line);
  }

  .section:first-of-type {
    border-top: 0;
    padding-block-start: var(--space-l);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-block-end: var(--space-l);
  }

  h2 {
    font-size: var(--step-3);
    margin-block-start: var(--space-3xs);
  }

  .eyebrow + h2 {
    margin-block-start: 0;
  }

  .action {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .action:hover {
    color: var(--accent);
  }
</style>
