---
import resume from '../data/resume.json';

const samples = resume.writingSamples;
---

<ul class="samples">
  {
    samples.map((sample) => (
      <li>
        <a href={sample.url} rel="noopener" target="_blank">
          <div class="text">
            <h3>{sample.title}</h3>
            <p class="why muted">{sample.description}</p>
            <p class="where">
              {sample.publication}
              <span class="sep">·</span>
              {sample.year}
            </p>
          </div>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .samples {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .samples > li + li {
    border-top: var(--border) var(--line);
  }

  a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m);
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    color: inherit;
  }

  a:hover h3 {
    color: var(--accent-ink);
  }

  a:hover .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  h3 {
    font-size: var(--step-1);
    transition: color var(--transition);
  }

  .why {
    font-size: var(--step--1);
    line-height: 1.55;
    margin-block: 0.2rem 0.35rem;
    max-width: 46ch;
  }

  .where {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .sep {
    margin-inline: 0.35rem;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--ink-faint);
    font-size: 1.1rem;
    line-height: 1.4;
    transition: color var(--transition), transform var(--transition);
  }
</style>
